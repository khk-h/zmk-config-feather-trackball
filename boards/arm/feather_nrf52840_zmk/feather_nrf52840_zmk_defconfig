# ZMK v0.3.0 の nice!nano v2 の定義と同じ内容（どちらも nRF52840 ＋ Adafruit の UF2 ブートローダ）

CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_FEATHER_NRF52840_ZMK=y

CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y

# UF2 ブートローダの配置に合わせてファームウェアを置き、.uf2 形式で出力する
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# ペアリング情報などをフラッシュに保存する
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y
