# 右＝セントラル（パソコンとつながる側、トラックボール付き）、左＝ペリフェラル

if SHIELD_TRACKBALL_TEST_SPLIT_RIGHT

    # Bluetooth で見える名前（16文字まで）
    config ZMK_KEYBOARD_NAME
        default "TB Split Test"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    config INPUT
        bool
        default y

    config PMW3610
        bool
        default y

    config SPI
        bool
        default y

endif

if SHIELD_TRACKBALL_TEST_SPLIT_LEFT || SHIELD_TRACKBALL_TEST_SPLIT_RIGHT

    config ZMK_SPLIT
        default y

    # キーマップにマウスのボタン（&mkp）があるので、左右とも有効にする
    config ZMK_POINTING
        bool
        default y

endif
